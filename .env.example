# ----- Database -----
# Neon: copy the pooled connection string from neon.tech, append ?sslmode=require
# Self-hosted: postgres://tcr:tcr@localhost:5432/tcr
DATABASE_URL=postgres://tcr:tcr@localhost:5432/tcr

# ----- LLM (for ai_summary, ai_oneliner; uses LiteLLM) -----
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ----- OpenReview (optional; anonymous fetch works for accept lists + abstracts; -----
# need credentials only when pulling reviewer scores on venues that gate them)
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=

# ----- Zotero (used by MCP save_to_zotero) -----
ZOTERO_API_KEY=
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=users

# ----- MCP server -----
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Host-side bind for docker-compose. 127.0.0.1 = local agents only.
MCP_BIND=127.0.0.1

# ----- Khoj export (deep-reading hand-off) -----
# Folder Khoj is configured to index. Curated papers' PDF + .md land here.
KHOJ_EXPORT_DIR=./data/khoj
# Khoj self-host base URL (for the "Open Khoj" deep-link).
KHOJ_BASE_URL=http://localhost:42110
# Public base URL of this TCR site (used in the .md back-link).
TCR_BASE_URL=http://localhost:3002
OPENPAPER_BASE_URL=http://localhost:3000
